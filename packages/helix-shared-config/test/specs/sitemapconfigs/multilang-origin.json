{
  "version": 1,
  "sitemaps": {
    "multilang": {
      "origin": "https://www.example.com",
      "languages": {
        "en": {
          "source": "/en/query-index.json",
          "destination": "/sitemap-en.xml",
          "hreflang": "en",
          "alternate": "/en/{path}"
        },
        "zh": {
          "source": "/zh/query-index.json",
          "destination": "/sitemap-zh.xml",
          "hreflang": "zh",
          "alternate": "/zh/{path}",
          "origin": "https://www.example.com.cn"
        }
      }
    }
  }
}
